# Copy to .env (never commit .env) or pass with `docker run --env-file .env`.
# Only DRE_API_KEY is required; everything else has a working default.

# Bearer token for POST /convert. Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DRE_API_KEY=

# Address the HTTP service listens on inside the container.
# DRE_BIND=0.0.0.0:8080

# Worker processes (auto: by cores and memory) and requests converted at once (0: = workers).
# DRE_WORKERS=auto
# DRE_CONCURRENCY=0
# DRE_WORKER_RSS_MB=

# Pages of one document recognized at once (auto: by cores and memory, at most 4).
# DRE_PAGE_THREADS=

# Machine speed relative to the reference laptop core; set from the self-check (see DEPLOY.md).
# DRE_SPEED_FACTOR=

# Recognition limits.
# DRE_OCR_ALLOWED_SCRIPTS=Latin,Cyrillic
# DRE_NATIVE_ALLOWED_SCRIPTS=Latin,Cyrillic
# DRE_MAX_PAGES=10
# DRE_MIN_LETTER_PX=8

# Optional locations of fonts and the prepared word lists.
# DRE_FONT_DIR=
# DRE_LEXICON_DIR=
